* text=auto

# Linux/server runtime files must stay LF.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.md text eol=lf

# Windows helper files.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary deploy/test assets.
*.wav binary
*.xz binary
*.gz binary
*.iso binary
*.img binary
