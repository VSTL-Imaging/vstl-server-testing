# =============================================================================
# VSTL Imaging Server — Local config (NEVER commit to git)
# =============================================================================
# Copy to .env and fill in real values: cp .env.example .env

# --- VSTL 360 backend ---
# Production API base URL (no trailing slash). The bench client appends paths
# like /imaging/lookup, /imaging/ingest, etc.
VSTL_API_BASE="https://tech-audit-system.emergent.host/api"

# X-API-Key for bench-to-VSTL machine-to-machine authentication.
# Get this from VSTL 360 webUI → /imaging → "API Keys" tab → Create Key.
# Treat as a secret — DO NOT share or commit.
VSTL_API_KEY="REPLACE_ME_WITH_REAL_API_KEY"

# --- Local downloadable audit reports ---
VSTL_REPORT_BASE="http://10.255.0.75/vstl-reports"
# The installer generates and preserves a random token when this is unchanged.
VSTL_REPORT_TOKEN="REPLACE_ME_WITH_RANDOM_REPORT_TOKEN"

# --- Imaging server (this host) ---
SERVER_IP="10.255.0.75"
SERVER_HOSTNAME="vstl-imaging"

# UEFI PXE first-stage loader.
# Use firmware SNP for UEFI systems. Latitude 5490-class firmware can
# intermittently lose the NIC when full iPXE reprobes hardware, so keep old
# Dell systems on snponly.efi unless you are testing a specific NIC override.
VSTL_UEFI_BOOTFILE="snponly.efi"
VSTL_OLD_DELL_UEFI_BOOTFILE="snponly.efi"

# USB live boot network behavior.
VSTL_SERVER_IP="10.255.0.75"
VSTL_WIFI_PROMPT=1

# --- FOG admin (set during install) ---
# These appear in 01_install_fog.sh comments — DO NOT store the password here in plaintext.
FOG_DB_NAME="fog"
FOG_DB_USER="fog"

# --- Bench network (the subnet refurb laptops sit on) ---
# Used by 02_install_dnsmasq.sh to scope PXE-only DHCP behavior.
BENCH_SUBNET="10.255.0.0/24"
BENCH_GATEWAY="10.255.0.1"
BENCH_DNS="10.255.0.75"  # the imaging server itself, or your existing DNS

# Short leases offered only to PXEClient firmware requests. This rescues older
# Dell/HP PXE firmware when the upstream DHCP server does not answer PXE boots.
VSTL_PXE_DHCP_START="10.255.0.244"
VSTL_PXE_DHCP_END="10.255.0.247"

# --- ISO build ---
LIVE_ISO_NAME="vstl-live-amd64.iso"
LIVE_ISO_HOSTNAME="vstl-bench"
# Live ISO uses these creds for the auto-login bench user (NOT the same as the server vstl user).
LIVE_ISO_USER="vstl"
LIVE_ISO_PASS="REPLACE_ME_WITH_LIVE_ISO_PASSWORD"
