# =============================================================================
# /opt/vstl/config.env — Bench client runtime configuration
# =============================================================================
# This file is baked into the Live ISO at build time. The 04_build_live_iso.sh
# script substitutes placeholders with values from /opt/vstl-imaging/.env on
# the imaging server.
#
# After ISO boot, this file lives at /opt/vstl/config.env and is read by:
#   - vstl-imaging-client.service (EnvironmentFile=)
#   - vstl-imaging-client.sh      (sourced at start)
# =============================================================================

# VSTL 360 backend
VSTL_API_BASE="https://tech-audit-system.emergent.host/api"
VSTL_API_KEY="REPLACE_AT_ISO_BUILD_TIME"

# This bench's identity — set per-bench in 04_build_live_iso.sh
BENCH_ID="bench-1"

# On-prem durable shift-session and cloud-retry storage. INSTALL.sh creates
# the token and copies these settings into the live boot environment.
VSTL_REPORT_BASE="http://10.255.0.75/vstl-reports"
VSTL_REPORT_TOKEN="REPLACE_AT_ISO_BUILD_TIME"

# FOG server (where to send image-deployment commands)
FOG_SERVER="http://10.255.0.75/fog"
VSTL_SERVER_IP="10.255.0.75"
FOG_API_TOKEN="REPLACE_AT_ISO_BUILD_TIME"
FOG_USER_API_TOKEN="REPLACE_AT_ISO_BUILD_TIME"

# Optional behaviors
VSTL_AUTO_SHUTDOWN=1           # 1 = reboot after successful session
VSTL_WIFI_PROMPT=1             # 1 = offer Wi-Fi when wired server access fails
VSTL_LOG="/var/log/vstl-imaging-client.log"
